# Bulwark Justfile Template - Go
# Generated by /bulwark-scaffold
#
# Tooling:
#   - Linter: golangci-lint (aggregator; runs vet/staticcheck/errcheck + 80 more)
#   - Formatter-check: gofmt -l (ships with Go toolchain, no install)
#   - Typecheck: go vet (built-in; catches format-string bugs, unreachable code)
# Install (golangci-lint — DO NOT use `go install`, maintainers prohibit it):
#   macOS:  brew install golangci-lint
#   Linux:  curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/master/install.sh | sh -s -- -b $(go env GOPATH)/bin latest
#   Win:    scoop install golangci-lint

set shell := ["bash", "-cu"]
set windows-shell := ["powershell.exe", "-c"]

# Default: list available recipes
default:
    @just --list

# Type/semantic checking with go vet
typecheck:
    @echo "Running go vet..."
    go vet ./...

# Linting with golangci-lint + gofmt diff check
lint:
    @echo "Running golangci-lint..."
    golangci-lint run ./...
    @echo "Running gofmt diff check..."
    test -z "$(gofmt -l .)"

# Build (all packages)
build:
    @echo "Running build..."
    go build ./...

# Test execution
test:
    @echo "Running tests..."
    go test ./...

# Auto-fix: format in-place
fix:
    @echo "Running gofmt (format in-place)..."
    gofmt -w .
    @echo "Auto-fix complete"

# CI: Run all quality checks in order
ci: typecheck lint build test
    @echo "All quality checks passed"

# Alias for manual invocation
check: ci
