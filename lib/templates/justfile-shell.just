# Bulwark Justfile Template - Shell
# Generated by /bulwark-scaffold
#
# Tooling:
#   - Linter: shellcheck (POSIX/bash static analysis)
#   - Formatter-check: shfmt --diff (check-only, never mutates)
# Install:
#   macOS:  brew install shellcheck shfmt
#   Linux:  apt install shellcheck; go install mvdan.cc/sh/v3/cmd/shfmt@latest
#   Win:    scoop install shellcheck shfmt

set shell := ["bash", "-cu"]
set windows-shell := ["powershell.exe", "-c"]

# Default: list available recipes
default:
    @just --list

# Typecheck: N/A for shell — shellcheck covers semantic analysis
typecheck:
    @echo "Typecheck: covered by shellcheck in lint recipe"

# Linting: shellcheck + shfmt --diff (check-only)
lint:
    @echo "Running shellcheck..."
    find . -name "*.sh" -not -path "./.git/*" -not -path "./node_modules/*" -not -path "./tmp/*" -not -path "./logs/*" -print0 | xargs -0 -r shellcheck
    @echo "Running shfmt diff check..."
    find . -name "*.sh" -not -path "./.git/*" -not -path "./node_modules/*" -not -path "./tmp/*" -not -path "./logs/*" -print0 | xargs -0 -r shfmt --diff

# Build: N/A for shell scripts
build:
    @echo "Build: not applicable for shell projects"

# Test execution (bats-core if present, else skip cleanly)
test:
    @echo "Running tests..."
    @if command -v bats >/dev/null 2>&1 && [ -d tests ]; then \
        bats tests/; \
    else \
        echo "No test runner configured (install bats-core or add tests/)"; \
    fi

# Auto-fix: format in-place
fix:
    @echo "Running shfmt (format in-place)..."
    find . -name "*.sh" -not -path "./.git/*" -not -path "./node_modules/*" -print0 | xargs -0 -r shfmt -w
    @echo "Auto-fix complete"

# CI: Run all quality checks in order
ci: typecheck lint build test
    @echo "All quality checks passed"

# Alias for manual invocation
check: ci

# ---------------------------------------------------------------------------
# Bulwark eval framework (P10.14 F5)
# ---------------------------------------------------------------------------
# Runtime dependency: bun. The install-bun and verify-bun recipes delegate to
# scripts/install-bun.sh (copied into the project by /bulwark-scaffold).
# The eval-* recipes assume skills/create-skill/scripts/ exists at runtime
# (i.e., the project has the Bulwark plugin installed via --plugin-dir or
# marketplace). Without create-skill present, eval-skill/eval-grade fail with
# a clear "no such file" — acceptable since the eval framework is opt-in.

# Install bun runtime (required for Bulwark eval framework + generated TS scripts)
install-bun:
    bash ./scripts/install-bun.sh

# Verify bun is present without installing (idempotent probe)
verify-bun:
    bash ./scripts/install-bun.sh --verify

# Run eval loop on a target skill (Layer 2 baseline)
eval-skill PATH:
    bun {{justfile_directory()}}/skills/create-skill/scripts/run-loop.ts {{PATH}}

# Grade an eval run; omit timestamp for latest
eval-grade PATH TIMESTAMP="latest":
    bun {{justfile_directory()}}/skills/create-skill/scripts/grade.ts {{PATH}} {{TIMESTAMP}}

# Run all evals (orchestrator) — call eval-skill / eval-grade directly with explicit paths.
eval:
    just eval-skill && just eval-grade
