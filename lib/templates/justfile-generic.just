# Bulwark Justfile Template - Generic (Fail-Loudly Fallback)
# Generated by /bulwark-scaffold when language detection falls through.
#
# This is a DELIBERATE "configure later" stub. Every quality recipe exits
# non-zero with instructions to either (a) replace this Justfile with a
# language-specific template from lib/templates/, or (b) customize the
# commands below for your project's toolchain.
#
# Silent passes are not offered — `just lint` returning zero without a
# real linter is the silent-crash anti-pattern Bulwark exists to prevent.

set shell := ["bash", "-cu"]
set windows-shell := ["powershell.exe", "-c"]

# Default: list available recipes
default:
    @just --list

# ============================================================
# Fail-Loudly Quality Recipes
# ============================================================
# Each recipe below exits 1 to force the user to configure real checks.

_not_configured recipe:
    @echo "ERROR: '{{recipe}}' is not configured for this project." >&2
    @echo "" >&2
    @echo "Bulwark's generic Justfile is a fail-loudly fallback — it will NOT" >&2
    @echo "silently pass quality checks. Choose one:" >&2
    @echo "" >&2
    @echo "  1. Replace this file with a language-specific template:" >&2
    @echo "       cp <bulwark-root>/lib/templates/justfile-{node,python,rust,go,shell,kotlin,swift}.just Justfile" >&2
    @echo "" >&2
    @echo "  2. Edit this Justfile to wire real '{{recipe}}' commands (e.g., mypy, tsc," >&2
    @echo "     cargo check, go vet, ktlint, shellcheck) then remove the fail-loudly block." >&2
    @echo "" >&2
    @echo "See lib/templates/ in the Bulwark plugin for reference implementations." >&2
    @exit 1

typecheck:
    @just _not_configured typecheck

lint:
    @just _not_configured lint

build:
    @just _not_configured build

test:
    @just _not_configured test

fix:
    @just _not_configured fix

# CI: Run all quality checks in order
ci: typecheck lint build test
    @echo "All quality checks passed"

# Alias for manual invocation
check: ci
