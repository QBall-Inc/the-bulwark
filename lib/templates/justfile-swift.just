# Bulwark Justfile Template - Swift
# Generated by /bulwark-scaffold
#
# Tooling:
#   - Linter: swiftlint --strict (warnings become errors; 200+ rules)
#   - Formatter-check: swift-format lint --strict (Apple's official formatter)
#   - Build/test: Swift Package Manager
# Install:
#   macOS:  brew install swiftlint swift-format
#   Linux:  SwiftLint via pre-built binary; swift-format requires build-from-source
#   Win:    Not supported — Swift tooling is macOS/Linux only
# Note: --strict promotes warnings to errors, ensuring non-zero exit on any violation.

set shell := ["bash", "-cu"]
set windows-shell := ["powershell.exe", "-c"]

# Default: list available recipes
default:
    @just --list

# Typecheck: swift build covers compilation (which catches type errors)
typecheck:
    @echo "Running swift build (typecheck)..."
    swift build

# Linting: swiftlint --strict + swift-format lint --strict
lint:
    @echo "Running swiftlint..."
    swiftlint lint --strict
    @echo "Running swift-format lint..."
    find . -name "*.swift" -not -path "./.build/*" -not -path "./tmp/*" -print0 | xargs -0 -r swift-format lint --strict

# Build (Swift Package Manager)
build:
    @echo "Running build..."
    swift build

# Test execution
test:
    @echo "Running tests..."
    swift test

# Auto-fix: swiftlint autocorrect + swift-format format-in-place
fix:
    @echo "Running swiftlint autocorrect..."
    swiftlint lint --fix
    @echo "Running swift-format (format in-place)..."
    find . -name "*.swift" -not -path "./.build/*" -print0 | xargs -0 -r swift-format format --in-place
    @echo "Auto-fix complete"

# CI: Run all quality checks in order
ci: typecheck lint build test
    @echo "All quality checks passed"

# Alias for manual invocation
check: ci
