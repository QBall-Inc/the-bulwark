# Bulwark Justfile Template - Kotlin
# Generated by /bulwark-scaffold
#
# Tooling:
#   - Linter: ktlint (style + formatting check; no --format = check-only)
#   - Static analysis: detekt (complexity, code smells, type-level issues)
#   - Build/test: delegated to Gradle if present
# Install (Java 11+ REQUIRED as a hard prerequisite):
#   macOS:  brew install ktlint detekt
#   Linux:  curl -sSLO https://github.com/pinterest/ktlint/releases/latest/download/ktlint && chmod +x ktlint
#           (detekt: download jar from https://github.com/detekt/detekt/releases)
#   Win:    scoop install ktlint detekt

set shell := ["bash", "-cu"]
set windows-shell := ["powershell.exe", "-c"]

# Default: list available recipes
default:
    @just --list

# Typecheck/static analysis: detekt
typecheck:
    @echo "Running detekt..."
    detekt --input . --excludes "**/build/**,**/.gradle/**,**/node_modules/**"

# Linting: ktlint check-only (no --format = check mode)
lint:
    @echo "Running ktlint..."
    ktlint "**/*.kt" "**/*.kts"

# Build: delegate to Gradle wrapper if present
build:
    @echo "Running build..."
    @if [ -f gradlew ]; then \
        ./gradlew build -x test; \
    else \
        echo "No Gradle wrapper found; skipping build"; \
    fi

# Test execution: delegate to Gradle wrapper if present
test:
    @echo "Running tests..."
    @if [ -f gradlew ]; then \
        ./gradlew test; \
    else \
        echo "No Gradle wrapper found; skipping test"; \
    fi

# Auto-fix: ktlint format
fix:
    @echo "Running ktlint (format in-place)..."
    ktlint --format "**/*.kt" "**/*.kts"
    @echo "Auto-fix complete"

# CI: Run all quality checks in order
ci: typecheck lint build test
    @echo "All quality checks passed"

# Alias for manual invocation
check: ci

# ============================================================
# Universal Validation Recipes (P10.21)
# ============================================================
# Stable recipe names the code-review skill dispatches to for per-language
# Phase 1 static analysis, regardless of which template a project scaffolded.
# Each recipe degrades gracefully when its tool is ABSENT (explicit skip
# message, exit 0) but propagates the tool's exit status when PRESENT (so a
# real type error / lint violation / malformed file fails the recipe).

# Python typecheck (graceful if mypy absent)
typecheck-py:
    @if command -v mypy >/dev/null 2>&1; then mypy .; else echo "mypy not installed; skipping"; fi

# Python lint (graceful if ruff absent)
lint-py:
    @if command -v ruff >/dev/null 2>&1; then ruff check .; else echo "ruff not installed; skipping"; fi

# Validate all JSON files (graceful if jq absent; fails on malformed JSON)
validate-json:
    @if command -v jq >/dev/null 2>&1; then \
        find . -name "*.json" -not -path "*/.git/*" -not -path "*/node_modules/*" -not -path "*/tmp/*" -not -path "*/logs/*" -print0 | xargs -0 -r -I {} jq empty {} || { echo "Invalid JSON detected"; exit 1; }; \
    else \
        echo "jq not installed; skipping JSON validation"; \
    fi

# Validate all YAML files (graceful if yamllint absent)
validate-yaml:
    @if command -v yamllint >/dev/null 2>&1; then \
        find . \( -name "*.yaml" -o -name "*.yml" \) -not -path "*/.git/*" -not -path "*/node_modules/*" -not -path "*/tmp/*" -not -path "*/logs/*" -print0 | xargs -0 -r yamllint -s; \
    else \
        echo "yamllint not installed; skipping"; \
    fi

# ---------------------------------------------------------------------------
# Bulwark eval framework (P10.14 F5)
# ---------------------------------------------------------------------------
# Runtime dependency: bun. The install-bun and verify-bun recipes delegate to
# scripts/install-bun.sh (copied into the project by /bulwark-scaffold).
# The eval-* recipes assume skills/create-skill/scripts/ exists at runtime
# (i.e., the project has the Bulwark plugin installed via --plugin-dir or
# marketplace). Without create-skill present, eval-skill/eval-grade fail with
# a clear "no such file" — acceptable since the eval framework is opt-in.

# Install bun runtime (required for Bulwark eval framework + generated TS scripts)
install-bun:
    bash ./scripts/install-bun.sh

# Verify bun is present without installing (idempotent probe)
verify-bun:
    bash ./scripts/install-bun.sh --verify

# Run eval loop on a target skill (Layer 2 baseline)
eval-skill PATH:
    bun {{justfile_directory()}}/skills/create-skill/scripts/run-loop.ts {{PATH}}

# Grade an eval run; omit timestamp for latest
eval-grade PATH TIMESTAMP="latest":
    bun {{justfile_directory()}}/skills/create-skill/scripts/grade.ts {{PATH}} {{TIMESTAMP}}

# Run all evals (orchestrator) — call eval-skill / eval-grade directly with explicit paths.
eval:
    just eval-skill && just eval-grade
